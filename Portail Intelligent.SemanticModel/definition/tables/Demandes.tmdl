table Demandes
	lineageTag: 97596c23-9a89-4df8-a44e-c32af58275c2

	/// Nombre total de demandes dans le modèle
	measure 'Total Demandes' = COUNTROWS(Demandes)
		formatString: #,0
		lineageTag: 159a100d-6e6d-4eea-b7c7-163729d06bce

	/// Demandes avec alerte retard active
	measure 'Demandes En Retard' = COUNTROWS(FILTER(Demandes, Demandes[Alerte_Retard_Active] = TRUE()))
		formatString: #,0
		lineageTag: 1b2c4599-ef56-48ae-ab46-dcdda2d58687

	/// Demandes avec échéance proche mais pas encore en retard
	measure 'Demandes Échéance Proche' = COUNTROWS(FILTER(Demandes, Demandes[Alerte_Echeance_Notifiee] = TRUE() && Demandes[Alerte_Retard_Active] = FALSE()))
		formatString: #,0
		lineageTag: 0e74f06b-7b13-4c21-ada0-592c7ac330d3

	/// Demandes sans gestionnaire assigné
	measure 'Demandes Non Assignées' = COUNTROWS(FILTER(Demandes, ISBLANK(Demandes[Gestionnaire_AssigneId])))
		formatString: #,0
		lineageTag: bd28d895-4b5e-401d-add3-ad4d4a5f365a

	/// Durée moyenne entre Date_Soumission et Date_Cloture, en heures, sur les demandes clôturées uniquement
	measure 'Délai Moyen Traitement (Heures)' =
			AVERAGEX(
			    FILTER(Demandes, NOT ISBLANK(Demandes[Date_Cloture])),
			    (Demandes[Date_Cloture] - Demandes[Date_Soumission]) * 24
			)
		formatString: #,0.00
		lineageTag: 4885a164-9e64-4424-b247-7a4bb7b995c8

	/// Proportion de demandes clôturées sans dépassement de délai
	measure 'Taux de Respect du SLA (%)' =
			VAR DemandesCloturees = FILTER(Demandes, NOT ISBLANK(Demandes[Date_Cloture]))
			VAR TotalCloturees = COUNTROWS(DemandesCloturees)
			VAR SansRetard = COUNTROWS(FILTER(DemandesCloturees, Demandes[Alerte_Retard_Active] = FALSE()))
			RETURN
			    IF(TotalCloturees = 0, BLANK(), DIVIDE(SansRetard, TotalCloturees) * 100)
		formatString: #,0.00
		lineageTag: 16c10166-dc64-4bc6-a647-c37ced6e08fc

	/// % de demandes avec Statut_Actuel = 'Rejeté'. Valeur attendue = 0 sur données initiales (statut non encore présent).
	measure 'Taux de Rejet (%)' =
			DIVIDE(
			    COUNTROWS(FILTER(Demandes, Demandes[Statut_Actuel] = "Rejeté")),
			    COUNTROWS(Demandes)
			) * 100
		formatString: #,0.00
		lineageTag: 4098b36f-c994-4072-a285-fd0b6e734cd4

	/// % de demandes avec Statut_Actuel = 'Validé'. Valeur attendue = 0 sur données initiales (statut transitoire avant Clôturé).
	measure 'Taux de Validation (%)' =
			DIVIDE(
			    COUNTROWS(FILTER(Demandes, Demandes[Statut_Actuel] = "Validé")),
			    COUNTROWS(Demandes)
			) * 100
		formatString: #,0.00
		lineageTag: b93ba2c4-0fd9-42b1-aee1-5d0322e19f41

	/// Nombre de demandes par service - utilise la relation active Demandes_ServiceSiege. À utiliser dans un visuel groupé par Services_Siege[Title].
	measure 'Demandes par Service' = CALCULATE(COUNTROWS(Demandes))
		formatString: #,0
		lineageTag: 9d88f641-771d-4682-9bf6-2300e02628bb

	/// Nombre de demandes assignées à chaque gestionnaire - utilise la relation inactive Demandes_GestionnaireAssigne via USERELATIONSHIP
	measure 'Demandes Traitées par Gestionnaire' =
			CALCULATE(
			    COUNTROWS(Demandes),
			    USERELATIONSHIP(Demandes[Gestionnaire_AssigneId], ListeInfoUtilisateur[ID.1])
			)
		formatString: #,0
		lineageTag: f3e42b08-1a49-4678-ae4e-8e62a69083b3

	/// Nombre de lignes Historique_Demandes avec Type_Modification = 'Transfert'
	measure 'Nombre de Transferts' = COUNTROWS(FILTER(Historique_Demandes, Historique_Demandes[Type_Modification] = "Transfert"))
		formatString: #,0
		lineageTag: 79bebd4b-ec69-4816-bb2f-1cbd0bf18ff8

	/// Temps moyen (heures) entre la Date_Soumission et la première ligne Historique de type 'Assignation'. Ignore les demandes sans historique d'assignation.
	measure 'Délai Moyen Assignation (Heures)' =
			AVERAGEX(
			    Demandes,
			    VAR PremiereDateAssignation =
			        MINX(
			            FILTER(
			                RELATEDTABLE(Historique_Demandes),
			                Historique_Demandes[Type_Modification] = "Assignation"
			            ),
			            Historique_Demandes[Date_Debut_Etape]
			        )
			    RETURN
			        IF(
			            NOT ISBLANK(PremiereDateAssignation),
			            (PremiereDateAssignation - Demandes[Date_Soumission]) * 24,
			            BLANK()
			        )
			)
		formatString: #,0.00
		lineageTag: f317425c-ce11-4fc1-8390-2e28b7035c29

	/// Nombre de demandes avec Statut_Actuel = 'Soumis'
	measure 'Demandes Soumises' = CALCULATE(COUNTROWS(Demandes), Demandes[Statut_Actuel] = "Soumis")
		formatString: #,0
		lineageTag: eb27fc0c-2f0e-4427-9439-6bcdc191c3e6

	/// Nombre de demandes avec Statut_Actuel = 'En cours'
	measure 'Demandes En Cours' = CALCULATE(COUNTROWS(Demandes), Demandes[Statut_Actuel] = "En cours")
		formatString: #,0
		lineageTag: f4c01cf0-dcb3-4f7a-9880-718da9b509e6

	/// Nombre de demandes avec Statut_Actuel = 'Clôturé'
	measure 'Demandes Clôturées' = CALCULATE(COUNTROWS(Demandes), Demandes[Statut_Actuel] = "Clôturé")
		formatString: #,0
		lineageTag: 35e1c477-f32f-4c25-a1a4-06218e01531f

	/// Nombre de demandes en retard ou en échéance proche
	measure 'Nombre Alertes Actives' = CALCULATE(COUNTROWS(Demandes), Demandes[Est_Alerte_Active] = TRUE())
		formatString: #,0
		lineageTag: 8dffc579-248d-4360-9971-7df0713375e3

	/// Nombre de demandes actuellement en attente d'un complément d'information
	measure 'Demandes En Attente Complément' = COALESCE(CALCULATE(COUNTROWS(Demandes), Demandes[En_Attente_Complement] = TRUE()), 0)
		formatString: #,0
		displayFolder: Compléments Information
		lineageTag: 2a62e181-e96f-40e8-8b92-5dfc93289e98

	/// Durée moyenne de pause (attente complément) en heures, sur les demandes ayant eu une pause
	measure 'Durée Moyenne Pause (Heures)' = AVERAGE(Demandes[Duree_Pause_Heures])
		formatString: #,0.00
		displayFolder: Compléments Information
		lineageTag: 28d36e93-ddc5-45c0-b3dc-7b2a3ffbe19c

	/// Somme des durées de pause (heures) sur l'ensemble des demandes
	measure 'Temps Total Pause (Heures)' = SUM(Demandes[Duree_Pause_Heures])
		formatString: #,0.00
		displayFolder: Compléments Information
		lineageTag: 85ef49fc-025b-4b46-80ac-6da51b1eee81

	/// Pourcentage de demandes actuellement suspendues en attente d'un complément
	measure 'Pourcentage Dossiers Suspendus' = DIVIDE([Demandes En Attente Complément], [Total Demandes]) * 100
		formatString: #,0.00
		displayFolder: Compléments Information
		lineageTag: 9142088d-2ded-4be3-9ff1-b03202aa67ce

	/// Délai moyen de traitement (heures) net du temps de pause côté client, sur les demandes clôturées
	measure 'Délai Traitement Net (Heures)' =
			AVERAGEX(
			    FILTER(Demandes, NOT ISBLANK(Demandes[Date_Cloture])),
			    Demandes[Délai Traitement (Heures)] - Demandes[Duree_Pause_Heures]
			)
		formatString: #,0.00
		displayFolder: Compléments Information
		lineageTag: 18423cd5-3e0d-421c-9904-9887fcd6bfda

	/// Nombre de demandes ayant une deadline métier définie
	measure 'Demandes Avec Deadline' = COALESCE(CALCULATE(COUNTROWS(Demandes), NOT ISBLANK(Demandes[Deadline_Metier])), 0)
		formatString: #,0
		displayFolder: Deadlines Métier
		lineageTag: 45e7fef1-91e5-43d4-8f07-980b149eada1

	/// Demandes avec deadline définie dont le statut n'est pas Dépassée (inclut les statuts non Dépassée et les statuts non encore renseignés)
	measure 'Deadlines Respectées' =
			COALESCE(
			    CALCULATE(
			        COUNTROWS(Demandes),
			        NOT ISBLANK(Demandes[Deadline_Metier]),
			        Demandes[Statut_Deadline] <> "Dépassée"
			    ),
			    0
			)
		formatString: #,0
		displayFolder: Deadlines Métier
		lineageTag: e86348be-4928-44e4-8d94-38fc3fcd3328

	/// Nombre de demandes dont la deadline métier est dépassée
	measure 'Deadlines Dépassées' = COALESCE(CALCULATE(COUNTROWS(Demandes), Demandes[Statut_Deadline] = "Dépassée"), 0)
		formatString: #,0
		displayFolder: Deadlines Métier
		lineageTag: b1a220cf-e649-447c-846e-75f48b4ca849

	/// Nombre de demandes en échéance proche (statut 'Proche échéance' non encore observé dans les données actuelles)
	measure 'Deadlines Proches' = COALESCE(CALCULATE(COUNTROWS(Demandes), Demandes[Statut_Deadline] = "Proche échéance"), 0)
		formatString: #,0
		displayFolder: Deadlines Métier
		lineageTag: 572484a1-e7b7-4372-8f85-792dfb8613e5

	/// Pourcentage de demandes avec deadline respectée parmi celles ayant une deadline définie
	measure 'Taux Respect Deadlines' = DIVIDE([Deadlines Respectées], [Demandes Avec Deadline]) * 100
		formatString: #,0.00
		displayFolder: Deadlines Métier
		lineageTag: 462d734d-468f-4cdc-8f27-8384ba1cc314

	/// Nombre moyen de jours restants avant la deadline métier (négatif = déjà dépassée), pour les demandes non clôturées avec deadline définie
	measure 'Jours Restants Moyen' =
			AVERAGEX(
			    FILTER(
			        Demandes,
			        NOT ISBLANK(Demandes[Deadline_Metier]) && Demandes[Statut_Actuel] <> "Clôturé"
			    ),
			    DATEDIFF(TODAY(), Demandes[Deadline_Metier], DAY)
			)
		formatString: #,0.0
		displayFolder: Deadlines Métier
		lineageTag: f277c8d5-02e9-4628-b807-508d11336726

	/// Nombre de demandes dont le type requiert une validation Direction Générale (via Types_Demandes[Niveau_Validation])
	measure 'Demandes Validation DG' =
			COALESCE(
			    CALCULATE(
			        COUNTROWS(Demandes),
			        FILTER(Demandes, RELATED(Types_Demandes[Niveau_Validation]) = "Direction_Generale")
			    ),
			    0
			)
		formatString: #,0
		displayFolder: Règles Métier Assurance
		lineageTag: add36919-aa7a-4498-ab2c-bcf927ebe976

	/// Nombre de demandes dont le type requiert une validation Simple (via Types_Demandes[Niveau_Validation])
	measure 'Demandes Validation Simple' =
			COALESCE(
			    CALCULATE(
			        COUNTROWS(Demandes),
			        FILTER(Demandes, RELATED(Types_Demandes[Niveau_Validation]) = "Simple")
			    ),
			    0
			)
		formatString: #,0
		displayFolder: Règles Métier Assurance
		lineageTag: 400835a4-a83f-449f-8ba3-0f5190d9de64

	/// Nombre de demandes dans le contexte de filtre courant - à utiliser dans un visuel groupé par Types_Demandes[Code_Metier] via la relation Demandes_TypeDemande
	measure 'Répartition Code Métier' = CALCULATE(COUNTROWS(Demandes))
		formatString: #,0
		displayFolder: Règles Métier Assurance
		lineageTag: 40138902-eff3-4c1d-89d3-981b0904ad1f

	/// Nombre de demandes possédant un commentaire de transfert renseigné
	measure 'Nombre Demandes Transférées' = COALESCE(CALCULATE(COUNTROWS(Demandes), NOT ISBLANK(Demandes[Commentaire_Transfert])), 0)
		formatString: #,0
		displayFolder: Transferts
		lineageTag: bacce8ba-8e85-44e5-ba19-47ac8dbf7daf

	/// Pourcentage de demandes ayant fait l'objet d'un transfert (commenté)
	measure 'Taux Transfert' = DIVIDE([Nombre Demandes Transférées], [Total Demandes]) * 100
		formatString: #,0.00
		displayFolder: Transferts
		lineageTag: a12d8936-ff86-4f57-b2d0-8dd8e166c9f1

	/// Nombre moyen de mouvements de type Transfert (Historique_Demandes) par demande
	measure 'Moyenne Transferts par Demande' =
			AVERAGEX(
			    Demandes,
			    CALCULATE(COUNTROWS(FILTER(Historique_Demandes, Historique_Demandes[Type_Modification] = "Transfert")))
			)
		formatString: #,0.00
		displayFolder: Transferts
		lineageTag: 2a32c546-aadf-4c9e-b1c1-925a0eeb5289

	/// Délai moyen prédit par le modèle ML (Prediction_Delai_ML, converti en numérique), sur les demandes ayant une prédiction
	measure 'Délai Moyen Prédit IA' =
			AVERAGEX(
			    FILTER(Demandes, NOT ISBLANK(Demandes[Prediction_Delai_ML])),
			    VALUE(Demandes[Prediction_Delai_ML])
			)
		formatString: #,0.00
		displayFolder: IA / Machine Learning
		lineageTag: 0861b298-ccd7-42ac-b884-7696bdc54674

	/// Probabilité moyenne de retard prédite par le modèle ML, en pourcentage
	measure 'Risque Moyen IA' = AVERAGE(Demandes[Probabilite_Retard_ML]) * 100
		formatString: #,0.00
		displayFolder: IA / Machine Learning
		lineageTag: 6343113e-778e-4a28-b3d6-06f001de825b

	/// Nombre de demandes avec probabilité de retard prédite > 70%
	measure 'Demandes Risque Élevé IA' =
			COALESCE(
			    CALCULATE(
			        COUNTROWS(Demandes),
			        NOT ISBLANK(Demandes[Probabilite_Retard_ML]),
			        Demandes[Probabilite_Retard_ML] > 0.70
			    ),
			    0
			)
		formatString: #,0
		displayFolder: IA / Machine Learning
		lineageTag: f62c90c1-8cea-417d-a1c6-1d12a25a581b

	/// Nombre de demandes avec probabilité de retard prédite entre 30% et 70%
	measure 'Demandes Risque Moyen IA' =
			COALESCE(
			    CALCULATE(
			        COUNTROWS(Demandes),
			        NOT ISBLANK(Demandes[Probabilite_Retard_ML]),
			        Demandes[Probabilite_Retard_ML] >= 0.30,
			        Demandes[Probabilite_Retard_ML] <= 0.70
			    ),
			    0
			)
		formatString: #,0
		displayFolder: IA / Machine Learning
		lineageTag: efe95e22-a4b9-46a8-b51a-29889d33456b

	/// Nombre de demandes avec probabilité de retard prédite < 30%
	measure 'Demandes Risque Faible IA' =
			COALESCE(
			    CALCULATE(
			        COUNTROWS(Demandes),
			        NOT ISBLANK(Demandes[Probabilite_Retard_ML]),
			        Demandes[Probabilite_Retard_ML] < 0.30
			    ),
			    0
			)
		formatString: #,0
		displayFolder: IA / Machine Learning
		lineageTag: df39a8d3-9d20-4222-8b55-1731a86371ec

	/// Version alternative du taux de respect SLA, basée sur la comparaison réelle entre le délai de traitement et Services_Siege[SLA_Theorique_Heures] (au lieu du flag précalculé Alerte_Retard_Active). Créée en BI-3, la mesure 'Taux de Respect du SLA (%)' d'origine est conservée pour compatibilité.
	measure 'Taux Respect SLA Réel' =
			VAR DemandesCloturees =
			    FILTER(
			        Demandes,
			        NOT ISBLANK(Demandes[Date_Cloture]) && NOT ISBLANK(RELATED(Services_Siege[SLA_Theorique_Heures]))
			    )
			VAR TotalCloturees = COUNTROWS(DemandesCloturees)
			VAR RespectSLA =
			    COUNTROWS(
			        FILTER(
			            DemandesCloturees,
			            Demandes[Délai Traitement (Heures)] <= RELATED(Services_Siege[SLA_Theorique_Heures])
			        )
			    )
			RETURN
			    IF(TotalCloturees = 0, BLANK(), DIVIDE(RespectSLA, TotalCloturees) * 100)
		formatString: #,0.00
		displayFolder: SLA
		lineageTag: 29fd0ea5-cf3f-4fbe-8146-a1612a3bb25b

