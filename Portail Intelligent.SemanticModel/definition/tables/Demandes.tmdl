	/// Conversion numérique de Prediction_Delai_ML (texte), pour comparaison directe avec le délai de traitement réel dans les visuels IA
	column Prediction_Delai_ML_Numeric = IF(ISBLANK(Demandes[Prediction_Delai_ML]), BLANK(), VALUE(Demandes[Prediction_Delai_ML]))
		dataType: double
		formatString: #,0.00
		lineageTag: fa9f10b2-67bf-4810-890e-36bfa4433daa
